{
  "$schema": "https://opencode.ai/config.json",
  // Inherit the user's selected provider and model.
  "commands": {
    "check-dotfiles": {
      "description": "Validate changed dotfiles and Stow behavior",
      "template": "Inspect the current diff and validate the affected packages following AGENTS.md. Run relevant syntax checks and the Stow regression tests when sync or package handling changed. Use Stow simulation for affected packages; report conflicts without applying links. Do not run the system bootstrap. Additional scope: $ARGUMENTS"
    },
    "review-dotfiles": {
      "description": "Review dotfiles for correctness and portability",
      "agent": "plan",
      "template": "Review the current diff for configuration errors, Stow path and folding mistakes, provider-specific assumptions, and regressions. Verify unfamiliar options against documentation. Report findings with file paths and line numbers. Additional scope: $ARGUMENTS"
    }
  }
}
